# Application
APP_NAME=Medical Tourism Platform
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/medical_tourism
DATABASE_ECHO=False

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (optional)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=False

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CORS_ALLOW_CREDENTIALS=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Super Admin (created on first run)
FIRST_SUPERUSER_EMAIL=admin@medicaltourism.com
FIRST_SUPERUSER_PASSWORD=Admin@123456

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads

# External Services
PAYMENT_GATEWAY_KEY=your-payment-gateway-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_API_KEY=your-ai-api-key

# SMTP Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=True
EMAIL_FROM_ADDRESS=noreply@medicaltourism.com
EMAIL_FROM_NAME=Medical Tourism Platform

# Google Calendar / Meet (for video appointment Meet link generation)
# Set GOOGLE_CALENDAR_ENABLED=True and provide a service account JSON path
GOOGLE_CALENDAR_ENABLED=False
GOOGLE_SERVICE_ACCOUNT_JSON=./google-service-account.json
GOOGLE_CALENDAR_TIMEZONE=UTC

# JaaS (Jitsi as a Service, https://jaas.8x8.vc) — used as the video call
# fallback when Google Calendar is disabled. Signs both patient and doctor
# in as moderator so neither sees the "waiting for the host" screen that
# public meet.jit.si shows to anonymous joiners.
# Sign up at jaas.8x8.vc, create an App ID and an API key (RSA keypair),
# then set the three values below. Falls back to plain meet.jit.si if unset.
JAAS_ENABLED=False
JAAS_APP_ID=
JAAS_API_KEY_ID=
JAAS_PRIVATE_KEY_PATH=./jaas-private-key.pem
JAAS_DOMAIN=8x8.vc

# Daily.co (https://dashboard.daily.co) — hosted WebRTC rooms via REST API.
# No shared email domain or per-doctor account needed: both patient and
# doctor get an owner-level meeting token, so whoever joins first starts
# the call. Checked before Google Calendar / JaaS when enabled.
# Get DAILY_API_KEY from dashboard.daily.co -> Developers.
# DAILY_DOMAIN is your Daily subdomain, e.g. "floramedcare" for
# floramedcare.daily.co (shown on the same Developers page).
DAILY_ENABLED=False
DAILY_API_KEY=
DAILY_DOMAIN=

# Self-hosted Jitsi Meet (open source — https://github.com/jitsi/docker-jitsi-meet).
# Fully free software, but YOU run the server: a VPS, a domain/subdomain
# pointed at it, TLS, and ideally your own TURN server for reliable
# NAT traversal. On the Jitsi server side, enable JWT auth and set
# JWT_APP_ID / JWT_APP_SECRET to match the two values below.
JITSI_SELFHOSTED_ENABLED=False
JITSI_SELFHOSTED_DOMAIN=meet.floramedcare.com
# Only needed for multi-tenant deployments that serve from a subdir
# (e.g. https://host:port/<this-value>/<room>) instead of "/". Leave blank otherwise.
JITSI_SELFHOSTED_BASE_PATH=
JITSI_SELFHOSTED_APP_ID=floramedcare
JITSI_SELFHOSTED_APP_SECRET=

SMTP_USERNAME=caludetest32@gmail.com
SMTP_PASSWORD=jhkc sntx rnmu qefs
EMAIL_FROM_ADDRESS=caludetest32@gmail.com
